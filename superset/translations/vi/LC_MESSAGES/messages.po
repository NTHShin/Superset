msgstr ""
"Đã xảy ra sự cố khi tìm nạp báo cáo được đính kèm vào trang tổng quan này."

msgid "There was an issue fetching the favorite status of this dashboard."
msgstr ""
"Đã xảy ra sự cố khi tìm nạp trạng thái yêu thích của trang tổng quan này."

#, python-format
msgid "There was an issue fetching your chart: %s"
msgstr "Đã xảy ra sự cố khi tìm nạp biểu đồ của bạn: %s"

#, python-format
msgid "There was an issue fetching your dashboards: %s"
msgstr "Đã xảy ra sự cố khi tìm nạp trang tổng quan của bạn: %s"

#, python-format
msgid "There was an issue fetching your recent activity: %s"
msgstr "Đã xảy ra sự cố khi tìm nạp hoạt động gần đây của bạn: %s"

#, python-format
msgid "There was an issue fetching your saved queries: %s"
msgstr "Đã xảy ra sự cố khi tìm nạp các truy vấn đã lưu của bạn: %s"

#, python-format
msgid "There was an issue previewing the selected query %s"
msgstr "Đã xảy ra sự cố khi xem trước truy vấn đã chọn %s"

#, python-format
msgid "There was an issue previewing the selected query. %s"
msgstr "Đã xảy ra sự cố khi xem trước truy vấn đã chọn. %S"

msgid "These are the datasets this filter will be applied to."
msgstr "Đây là những bộ dữ liệu mà bộ lọc này sẽ được áp dụng."

msgid ""
"This JSON object is generated dynamically when clicking the save or "
"overwrite button in the dashboard view. It is exposed here for reference and"
" for power users who may want to alter specific parameters."
msgstr ""
"Đối tượng JSON này được tạo động khi nhấp vào nút lưu hoặc ghi đè trong chế "
"độ xem trang tổng quan. Nó được trình bày ở đây để tham khảo và cho người "
"dùng thành thạo có thể muốn thay đổi các thông số cụ thể."

#, python-format
msgid "This action will permanently delete %s."
msgstr "Hành động này sẽ xóa vĩnh viễn %s."

msgid "This action will permanently delete the layer."
msgstr "Hành động này sẽ xóa vĩnh viễn lớp."

msgid "This action will permanently delete the role."
msgstr "Hành động này sẽ xóa vĩnh viễn vai trò này."

msgid "This action will permanently delete the saved query."
msgstr "Hành động này sẽ xóa vĩnh viễn truy vấn đã lưu."

msgid "This action will permanently delete the template."
msgstr "Hành động này sẽ xóa vĩnh viễn mẫu."

msgid "This action will permanently delete the user."
msgstr "Hành động này sẽ xóa vĩnh viễn người dùng."

msgid ""
"This can be either an IP address (e.g. 127.0.0.1) or a domain name (e.g. "
"mydatabase.com)."
msgstr ""
"Đây có thể là địa chỉ IP (ví dụ: 127.0.0.1) hoặc tên miền (ví dụ: "
"mydatabase.com)."

msgid ""
"This chart applies cross-filters to charts whose datasets contain columns "
"with the same name."
msgstr ""
"Biểu đồ này áp dụng các bộ lọc chéo cho các biểu đồ có tập dữ liệu chứa các "
"cột có cùng tên."

msgid "This chart has been moved to a different filter scope."
msgstr "Biểu đồ này đã được chuyển sang phạm vi bộ lọc khác."

msgid "This chart is managed externally, and can't be edited in Superset"
msgstr ""
"Biểu đồ này được quản lý bên ngoài và không thể chỉnh sửa trong Superset"

msgid ""
"This chart might be incompatible with the filter (datasets don't match)"
msgstr ""
"Biểu đồ này có thể không tương thích với bộ lọc (bộ dữ liệu không khớp)"

msgid ""
"This chart type is not supported when using an unsaved query as a chart "
"source. "
msgstr ""
"Loại biểu đồ này không được hỗ trợ khi sử dụng truy vấn chưa được lưu làm "
"nguồn biểu đồ."

msgid "This column might be incompatible with current dataset"
msgstr "Cột này có thể không tương thích với tập dữ liệu hiện tại"

msgid "This column must contain date/time information."
msgstr "Cột này phải chứa thông tin ngày/giờ."

msgid ""
"This control filters the whole chart based on the selected time range. All "
"relative times, e.g. \"Last month\", \"Last 7 days\", \"now\", etc. are "
"evaluated on the server using the server's local time (sans timezone). All "
"tooltips and placeholder times are expressed in UTC (sans timezone). The "
"timestamps are then evaluated by the database using the engine's local "
"timezone. Note one can explicitly set the timezone per the ISO 8601 format "
"if specifying either the start and/or end time."
msgstr ""
"Điều khiển này lọc toàn bộ biểu đồ dựa trên phạm vi thời gian đã chọn. Tất "
"cả thời gian tương đối, ví dụ: \"Tháng trước\", \"7 ngày qua\", \"bây giờ\","
" v.v. được đánh giá trên máy chủ bằng cách sử dụng giờ địa phương của máy "
"chủ (không có múi giờ). Tất cả chú giải công cụ và thời gian giữ chỗ được "
"thể hiện bằng UTC (không có múi giờ). Sau đó, dấu thời gian được cơ sở dữ "
"liệu đánh giá bằng múi giờ cục bộ của công cụ. Lưu ý người ta có thể đặt rõ "
"ràng múi giờ theo định dạng ISO 8601 nếu chỉ định thời gian bắt đầu và/hoặc "
"kết thúc."

msgid ""
"This controls whether the \"time_range\" field from the current\n"
"                  view should be passed down to the chart containing the annotation data."
msgstr ""
"Điều này kiểm soát xem trường \"time_range\" từ hiện tại\n"
"                  chế độ xem phải được chuyển xuống biểu đồ chứa dữ liệu chú thích."

msgid ""
"This controls whether the time grain field from the current\n"
"                  view should be passed down to the chart containing the annotation data."
msgstr ""
"Điều này kiểm soát xem trường hạt thời gian từ hiện tại có\n"
"                  chế độ xem phải được chuyển xuống biểu đồ chứa dữ liệu chú thích."

