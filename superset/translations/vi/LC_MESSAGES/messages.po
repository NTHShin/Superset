msgid "The color for points and clusters in RGB"
msgstr "Màu sắc cho điểm và cụm trong RGB"

msgid "The color of the elements border"
msgstr "Màu sắc của đường viền các phần tử"

msgid "The color of the isoband"
msgstr "Màu sắc của isoband"

msgid "The color of the isoline"
msgstr "Màu sắc của chất cô lập"

msgid "The color scheme for rendering chart"
msgstr "Bảng màu cho biểu đồ kết xuất"

msgid ""
"The color scheme is determined by the related dashboard.\n"
"        Edit the color scheme in the dashboard properties."
msgstr ""
"Bảng màu được xác định bởi bảng điều khiển liên quan.\n"
"        Chỉnh sửa bảng màu trong thuộc tính bảng điều khiển."

msgid ""
"The colors of this chart might be overridden by custom label colors of the related dashboard.\n"
"    Check the JSON metadata in the Advanced settings."
msgstr ""
"Màu của biểu đồ này có thể bị ghi đè bằng màu nhãn tùy chỉnh của trang tổng quan có liên quan.\n"
"    Kiểm tra siêu dữ liệu JSON trong cài đặt Nâng cao."

msgid "The column header label"
msgstr "Nhãn tiêu đề cột"

msgid "The column to be used as the source of the edge."
msgstr "Cột được sử dụng làm nguồn của cạnh."

msgid "The column to be used as the target of the edge."
msgstr "Cột được sử dụng làm mục tiêu của cạnh."

msgid "The column was deleted or renamed in the database."
msgstr "Cột đã bị xóa hoặc đổi tên trong cơ sở dữ liệu."

msgid "The configuration for the map layers"
msgstr "Cấu hình các lớp bản đồ"

msgid "The corner radius of the chart background"
msgstr "Bán kính góc của nền biểu đồ"

msgid ""
"The country code standard that Superset should expect to find in the "
"[country] column"
msgstr ""
"Tiêu chuẩn mã quốc gia mà Superset mong đợi sẽ tìm thấy trong cột [quốc gia]"

msgid "The dashboard has been saved"
msgstr "Bảng điều khiển đã được lưu"

msgid "The data source seems to have been deleted"
msgstr "Nguồn dữ liệu dường như đã bị xóa"

msgid "The database"
msgstr "Cơ sở dữ liệu"

msgid "The database columns that contains lines information"
msgstr "Các cột cơ sở dữ liệu chứa thông tin dòng"

msgid "The database could not be found"
msgstr "Không thể tìm thấy cơ sở dữ liệu"

msgid "The database is currently running too many queries."
msgstr "Cơ sở dữ liệu hiện đang chạy quá nhiều truy vấn."

msgid "The database is under an unusual load."
msgstr "Cơ sở dữ liệu đang chịu tải bất thường."

msgid ""
"The database referenced in this query was not found. Please contact an "
"administrator for further assistance or try again."
msgstr ""
"Không tìm thấy cơ sở dữ liệu được tham chiếu trong truy vấn này. Vui lòng "
"liên hệ với quản trị viên để được hỗ trợ thêm hoặc thử lại."

msgid "The database returned an unexpected error."
msgstr "Cơ sở dữ liệu trả về một lỗi không mong muốn."

msgid "The database that was used to generate this query could not be found"
msgstr "Không thể tìm thấy cơ sở dữ liệu được sử dụng để tạo truy vấn này"

msgid "The database was deleted."
msgstr "Cơ sở dữ liệu đã bị xóa."

msgid "The database was not found."
msgstr "Cơ sở dữ liệu không được tìm thấy."

msgid "The dataset"
msgstr "Tập dữ liệu"

msgid "The dataset associated with this chart no longer exists"
msgstr "Tập dữ liệu được liên kết với biểu đồ này không còn tồn tại"

msgid ""
"The dataset column/metric that returns the values on your chart's x-axis."
msgstr "Cột/số liệu tập dữ liệu trả về các giá trị trên trục x của biểu đồ."

msgid ""
"The dataset column/metric that returns the values on your chart's y-axis."
msgstr ""
"Cột/số liệu tập dữ liệu trả về các giá trị trên trục y của biểu đồ của bạn."

msgid ""
"The dataset configuration exposed here\n"
"                affects all the charts using this dataset.\n"
"                Be mindful that changing settings\n"
"                here may affect other charts\n"
"                in undesirable ways."
msgstr ""
"Cấu hình tập dữ liệu được hiển thị ở đây\n"
"                ảnh hưởng đến tất cả các biểu đồ sử dụng tập dữ liệu này.\n"
"                Hãy lưu ý rằng việc thay đổi cài đặt\n"
"                ở đây có thể ảnh hưởng đến các biểu đồ khác\n"
"                theo những cách không mong muốn."

msgid "The dataset has been saved"
msgstr "Tập dữ liệu đã được lưu"

msgid "The dataset linked to this chart may have been deleted."
msgstr "Tập dữ liệu được liên kết với biểu đồ này có thể đã bị xóa."

msgid "The datasource couldn't be loaded"
msgstr "Không thể tải nguồn dữ liệu"

msgid "The datasource is too large to query."
msgstr "Nguồn dữ liệu quá lớn để truy vấn."

msgid "The default catalog that should be used for the connection."
msgstr "Danh mục mặc định sẽ được sử dụng cho kết nối."

msgid "The default schema that should be used for the connection."
msgstr "Lược đồ mặc định sẽ được sử dụng cho kết nối."

msgid ""
"The description can be displayed as widget headers in the dashboard view. "
"Supports markdown."
msgstr ""
"Mô tả có thể được hiển thị dưới dạng tiêu đề tiện ích trong chế độ xem trang"
" tổng quan. Hỗ trợ đánh dấu."

msgid "The distance between cells, in pixels"
msgstr "Khoảng cách giữa các ô, tính bằng pixel"

msgid ""
"The duration of time in seconds before the cache is invalidated. Set to -1 "
"to bypass the cache."
msgstr ""
"Khoảng thời gian tính bằng giây trước khi bộ đệm bị vô hiệu. Đặt thành -1 để"
" bỏ qua bộ đệm."

msgid "The encoding format of the lines"
msgstr "Định dạng mã hóa của dòng"

msgid ""
"The engine_params object gets unpacked into the sqlalchemy.create_engine "
"call."
msgstr ""
"Đối tượng engine_params được giải nén trong lệnh gọi "
"sqlalchemy.create_engine."

msgid "The exponent to compute all sizes from. \"EXP\" only"
msgstr "Số mũ để tính toán tất cả các kích thước từ. Chỉ \"EXP\""

msgid ""
"The extent of the map on application start. FIT DATA automatically sets the "
"extent so that all data points are included in the viewport. CUSTOM allows "
"users to define the extent manually."
msgstr ""
"Phạm vi của bản đồ khi bắt đầu ứng dụng. FIT DATA tự động đặt phạm vi để tất"
" cả các điểm dữ liệu được đưa vào khung nhìn. TÙY CHỈNH cho phép người dùng "
"xác định phạm vi theo cách thủ công."

#, python-format
msgid ""
"The following entries in `series_columns` are missing in `columns`: "
"%(columns)s. "
msgstr ""
"Các mục sau đây trong `series_columns` bị thiếu trong `columns`: "
"%(columns)s."

#, python-format
msgid ""
"The following filters have the 'Select first filter value by default'\n"
"                    option checked and could not be loaded, which is preventing the dashboard\n"
"                    from rendering: %s"
msgstr ""
"Các bộ lọc sau có 'Chọn giá trị bộ lọc đầu tiên theo mặc định'\n"
"                    tùy chọn đã được kiểm tra và không thể tải được, điều này đang ngăn bảng điều khiển\n"
"                    từ kết xuất: %s"

msgid "The function to use when aggregating points into groups"
msgstr "Hàm sử dụng khi gộp điểm thành nhóm"

msgid "The height of the current zoom level to compute all heights from"
msgstr ""
"Chiều cao của mức thu phóng hiện tại để tính toán tất cả các độ cao từ"

msgid ""
"The histogram chart displays the distribution of a dataset by\n"
"          representing the frequency or count of values within different ranges or bins.\n"
"          It helps visualize patterns, clusters, and outliers in the data and provides\n"
"          insights into its shape, central tendency, and spread."
msgstr ""
"Biểu đồ biểu đồ hiển thị sự phân bố của tập dữ liệu theo\n"
"          biểu thị tần số hoặc số lượng giá trị trong các phạm vi hoặc thùng khác nhau.\n"
"          Nó giúp trực quan hóa các mẫu, cụm và các ngoại lệ trong dữ liệu và cung cấp\n"
"          cái nhìn sâu sắc về hình dạng, xu hướng trung tâm và sự lan rộng của nó."

#, python-format
msgid "The host \"%(hostname)s\" might be down and can't be reached."
msgstr ""
"Máy chủ \"%(hostname)s\" có thể không hoạt động và không thể liên lạc được."

#, python-format
msgid ""
"The host \"%(hostname)s\" might be down, and can't be reached on port "
"%(port)s."
msgstr ""
"Máy chủ \"%(tên máy chủ)s\" có thể không hoạt động và không thể truy cập "
"được trên cổng %(port)s."

msgid "The host might be down, and can't be reached on the provided port."
msgstr ""
"Máy chủ có thể không hoạt động và không thể kết nối được trên cổng được cung"
" cấp."

#, python-format
msgid "The hostname \"%(hostname)s\" cannot be resolved."
msgstr "Tên máy chủ \"%(hostname)s\" không thể giải quyết được."

msgid "The hostname provided can't be resolved."
msgstr "Không thể giải quyết tên máy chủ được cung cấp."

msgid "The id of the active chart"
msgstr "Id của biểu đồ đang hoạt động"

msgid "The layer attribution"
msgstr "Thuộc tính lớp"

msgid "The lower limit of the threshold range of the Isoband"
msgstr "Giới hạn dưới của phạm vi ngưỡng của Isoband"

msgid ""
"The maximum number of subdivisions of each group; lower values are pruned "
"first"
msgstr ""
"Số lượng phân khu tối đa của mỗi nhóm; giá trị thấp hơn được cắt tỉa trước"

msgid "The maximum value of metrics. It is an optional configuration"
msgstr "Giá trị tối đa của số liệu. Đây là một cấu hình tùy chọn"

#, python-format
msgid ""
"The metadata_params in Extra field is not configured correctly. The key "
"%(key)s is invalid."
msgstr ""
"Thông số siêu dữ liệu trong trường Bổ sung không được định cấu hình chính "
"xác. Khóa %(key)s không hợp lệ."

msgid ""
"The metadata_params in Extra field is not configured correctly. The key "
"%{key}s is invalid."
msgstr ""
"Thông số siêu dữ liệu trong trường Bổ sung không được định cấu hình chính "
"xác. Khóa %{key}s không hợp lệ."

msgid ""
"The metadata_params object gets unpacked into the sqlalchemy.MetaData call."
msgstr ""
"Đối tượng siêu dữ liệu_params được giải nén vào lệnh gọi "
"sqlalchemy.MetaData."

msgid ""
"The minimum number of rolling periods required to show a value. For instance"
" if you do a cumulative sum on 7 days you may want your \"Min Period\" to be"
" 7, so that all data points shown are the total of 7 periods. This will hide"
" the \"ramp up\" taking place over the first 7 periods"
msgstr ""
"Số lượng thời gian lăn tối thiểu cần thiết để hiển thị một giá trị. Ví dụ: "
"nếu bạn tính tổng tích lũy trong 7 ngày, bạn có thể muốn \"Giai đoạn tối "
"thiểu\" của mình là 7, sao cho tất cả các điểm dữ liệu được hiển thị là tổng"
" cộng của 7 giai đoạn. Điều này sẽ ẩn đi sự “tăng tốc” diễn ra trong 7 tiết "
"đầu tiên"

msgid ""
"The minimum value of metrics. It is an optional configuration. If not set, "
"it will be the minimum value of the data"
msgstr ""
"Giá trị tối thiểu của số liệu. Đây là một cấu hình tùy chọn. Nếu không được "
"đặt, nó sẽ là giá trị tối thiểu của dữ liệu"

msgid "The name of the geometry column"
msgstr "Tên cột hình học"

msgid "The name of the layer as described in GetCapabilities"
msgstr "Tên của lớp như được mô tả trong GetCapabilities"

msgid "The name of the rule must be unique"
msgstr "Tên của quy tắc phải là duy nhất"

msgid "The number color \"steps\""
msgstr "Màu số “bậc thang”"

msgid "The number of bins for the histogram"
msgstr "Số lượng thùng cho biểu đồ"

msgid ""
"The number of hours, negative or positive, to shift the time column. This "
"can be used to move UTC time to local time."
msgstr ""
"Số giờ, âm hoặc dương, để dịch chuyển cột thời gian. Điều này có thể được sử"
" dụng để chuyển thời gian UTC sang giờ địa phương."

#, python-format
msgid ""
"The number of results displayed is limited to %(rows)d by the configuration "
"DISPLAY_MAX_ROW. Please add additional limits/filters or download to csv to "
"see more rows up to the %(limit)d limit."
msgstr ""
"Số lượng kết quả được hiển thị bị giới hạn ở %(rows)d bởi cấu hình "
"DISPLAY_MAX_ROW. Vui lòng thêm các giới hạn/bộ lọc bổ sung hoặc tải xuống "
"csv để xem thêm các hàng đạt đến giới hạn %(limit)d."

#, python-format
msgid ""
"The number of results displayed is limited to %(rows)d. Please add "
"additional limits/filters, download to csv, or contact an admin to see more "
"rows up to the %(limit)d limit."
msgstr ""
"Số lượng kết quả được hiển thị được giới hạn ở %(rows)d. Vui lòng thêm các "
"giới hạn/bộ lọc bổ sung, tải xuống csv hoặc liên hệ với quản trị viên để xem"
" thêm các hàng đạt tới giới hạn %(limit)d."

#, python-format
msgid "The number of rows displayed is limited to %(rows)d by the dropdown."
msgstr ""
"Số lượng hàng được hiển thị được giới hạn ở %(rows)d theo danh sách thả "
"xuống."

#, python-format
msgid ""
"The number of rows displayed is limited to %(rows)d by the limit dropdown."
msgstr ""
"Số lượng hàng được hiển thị bị giới hạn ở %(rows)d bởi trình đơn thả xuống "
"giới hạn."

#, python-format
msgid "The number of rows displayed is limited to %(rows)d by the query"
msgstr "Số lượng hàng được hiển thị được giới hạn ở %(rows)d bởi truy vấn"

#, python-format
msgid ""
"The number of rows displayed is limited to %(rows)d by the query and limit "
"dropdown."
msgstr ""
"Số lượng hàng được hiển thị bị giới hạn ở %(rows)d bởi truy vấn và giới hạn "
"thả xuống."

msgid "The number of seconds before expiring the cache"
msgstr "Số giây trước khi bộ đệm hết hạn"

msgid "The object does not exist in the given database."
msgstr "Đối tượng không tồn tại trong cơ sở dữ liệu nhất định."

#, python-format
msgid "The parameter %(parameters)s in your query is undefined."
msgid_plural ""
"The following parameters in your query are undefined: %(parameters)s."
msgstr[0] ""
msgstr[1] ""

#, python-format
msgid "The password provided for username \"%(username)s\" is incorrect."
msgstr ""
"Mật khẩu được cung cấp cho tên người dùng \"%(username)s\" không chính xác."

msgid "The password provided when connecting to a database is not valid."
msgstr "Mật khẩu được cung cấp khi kết nối với cơ sở dữ liệu không hợp lệ."

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the charts. Please note that the \"Secure Extra\" and "
"\"Certificate\" sections of the database configuration are not present in "
"export files, and should be added manually after the import if they are "
"needed."
msgstr ""
"Cần có mật khẩu cho cơ sở dữ liệu bên dưới để nhập chúng cùng với biểu đồ. "
"Xin lưu ý rằng phần \"Secure Extra\" và \"Chứng chỉ\" của cấu hình cơ sở dữ "
"liệu không có trong tệp xuất và phải được thêm thủ công sau khi nhập nếu "
"cần."

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the dashboards. Please note that the \"Secure Extra\" and "
"\"Certificate\" sections of the database configuration are not present in "
"export files, and should be added manually after the import if they are "
"needed."
msgstr ""
"Cần có mật khẩu cho cơ sở dữ liệu bên dưới để nhập chúng cùng với trang tổng"
" quan. Xin lưu ý rằng phần \"Secure Extra\" và \"Chứng chỉ\" của cấu hình cơ"
" sở dữ liệu không có trong tệp xuất và phải được thêm thủ công sau khi nhập "
"nếu cần."

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the datasets. Please note that the \"Secure Extra\" and "
"\"Certificate\" sections of the database configuration are not present in "
"export files, and should be added manually after the import if they are "
"needed."
msgstr ""
"Cần có mật khẩu cho cơ sở dữ liệu bên dưới để nhập chúng cùng với các bộ dữ "
"liệu. Xin lưu ý rằng phần \"Secure Extra\" và \"Chứng chỉ\" của cấu hình cơ "
"sở dữ liệu không có trong tệp xuất và phải được thêm thủ công sau khi nhập "
"nếu cần."

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the saved queries. Please note that the \"Secure Extra\" and "
"\"Certificate\" sections of the database configuration are not present in "
"export files, and should be added manually after the import if they are "
"needed."
msgstr ""
"Cần có mật khẩu cho cơ sở dữ liệu bên dưới để nhập chúng cùng với các truy "
"vấn đã lưu. Xin lưu ý rằng phần \"Secure Extra\" và \"Chứng chỉ\" của cấu "
"hình cơ sở dữ liệu không có trong tệp xuất và phải được thêm thủ công sau "
"khi nhập nếu cần."

msgid ""
"The passwords for the databases below are needed in order to import them. "
"Please note that the \"Secure Extra\" and \"Certificate\" sections of the "
"database configuration are not present in explore files and should be added "
"manually after the import if they are needed."
msgstr ""
"Cần có mật khẩu cho cơ sở dữ liệu bên dưới để nhập chúng. Xin lưu ý rằng "
"phần \"Secure Extra\" và \"Chứng chỉ\" của cấu hình cơ sở dữ liệu không có "
"trong tệp khám phá và phải được thêm thủ công sau khi nhập nếu cần."

msgid "The pattern of timestamp format. For strings use "
msgstr "Mẫu định dạng dấu thời gian. Để sử dụng chuỗi"

msgid ""
"The periodicity over which to pivot time. Users can provide\n"
"            \"Pandas\" offset alias.\n"
"            Click on the info bubble for more details on accepted \"freq\" expressions."
msgstr ""
"Tính tuần hoàn để xoay chuyển thời gian. Người dùng có thể cung cấp\n"
"            Bí danh bù đắp \"Gấu trúc\".\n"
"            Nhấp vào bong bóng thông tin để biết thêm chi tiết về các biểu thức \"tần số\" được chấp nhận."

msgid "The pixel radius"
msgstr "Bán kính pixel"

msgid ""
"The pointer to a physical table (or view). Keep in mind that the chart is "
"associated to this Superset logical table, and this logical table points the"
" physical table referenced here."
msgstr ""
"Con trỏ tới một bảng vật lý (hoặc dạng xem). Hãy nhớ rằng biểu đồ được liên "
"kết với bảng logic Superset này và bảng logic này trỏ đến bảng vật lý được "
"tham chiếu ở đây."

msgid "The port is closed."
msgstr "Cảng đã đóng cửa."

msgid "The port number is invalid."
msgstr "Số cổng không hợp lệ."

msgid "The primary metric is used to define the arc segment sizes"
msgstr "Số liệu chính được sử dụng để xác định kích thước đoạn cung"

msgid "The provided table was not found in the provided database"
msgstr "Không tìm thấy bảng được cung cấp trong cơ sở dữ liệu được cung cấp"

msgid "The query associated with the results was deleted."
msgstr "Truy vấn liên quan đến kết quả đã bị xóa."

msgid ""
"The query associated with these results could not be found. You need to re-"
"run the original query."
msgstr ""
"Không thể tìm thấy truy vấn liên quan đến những kết quả này. Bạn cần chạy "
"lại truy vấn ban đầu."

msgid "The query contains one or more malformed template parameters."
msgstr "Truy vấn chứa một hoặc nhiều tham số mẫu không đúng định dạng."

msgid "The query couldn't be loaded"
msgstr "Không thể tải truy vấn"

#, python-format
msgid ""
"The query estimation was killed after %(sqllab_timeout)s seconds. It might "
"be too complex, or the database might be under heavy load."
msgstr ""
"Ước tính truy vấn đã bị hủy sau %(sqllab_timeout)s giây. Nó có thể quá phức "
"tạp hoặc cơ sở dữ liệu có thể đang chịu tải nặng."

msgid "The query has a syntax error."
msgstr "Truy vấn có lỗi cú pháp."

msgid "The query returned no data"
msgstr "Truy vấn không trả về dữ liệu"

#, python-format
msgid ""
"The query was killed after %(sqllab_timeout)s seconds. It might be too "
"complex, or the database might be under heavy load."
msgstr ""
"Truy vấn bị hủy sau %(sqllab_timeout)s giây. Nó có thể quá phức tạp hoặc cơ "
"sở dữ liệu có thể đang chịu tải nặng."

msgid ""
"The radius (in pixels) the algorithm uses to define a cluster. Choose 0 to "
"turn off clustering, but beware that a large number of points (>1000) will "
"cause lag."
msgstr ""
"Bán kính (tính bằng pixel) mà thuật toán sử dụng để xác định một cụm. Chọn 0"
" để tắt phân cụm, nhưng hãy cẩn thận vì số lượng lớn điểm (>1000) sẽ gây ra "
"độ trễ."

msgid ""
"The radius of individual points (ones that are not in a cluster). Either a "
"numerical column or `Auto`, which scales the point based on the largest "
"cluster"
msgstr ""
"Bán kính của các điểm riêng lẻ (những điểm không nằm trong cụm). Cột số hoặc"
" `Tự động`, chia tỷ lệ điểm dựa trên cụm lớn nhất"

msgid "The report has been created"
msgstr "Báo cáo đã được tạo"

msgid "The report will be sent to your email at"
msgstr "Báo cáo sẽ được gửi đến email của bạn tại"

msgid ""
"The result of this query must be a value capable of numeric interpretation "
"e.g. 1, 1.0, or \"1\" (compatible with Python's float() function)."
msgstr ""
"Kết quả của truy vấn này phải là một giá trị có khả năng diễn giải số, ví "
"dụ: 1, 1.0 hoặc \"1\" (tương thích với hàm float() của Python)."

msgid "The result size exceeds the allowed limit."
msgstr "Kích thước kết quả vượt quá giới hạn cho phép."

msgid "The results backend no longer has the data from the query."
msgstr "Phần phụ trợ kết quả không còn có dữ liệu từ truy vấn."

msgid ""
"The results stored in the backend were stored in a different format, and no "
"longer can be deserialized."
msgstr ""
"Các kết quả được lưu trữ trong phần phụ trợ được lưu trữ ở định dạng khác và"
" không thể giải tuần tự hóa được nữa."

msgid "The rich tooltip shows a list of all series for that point in time"
msgstr ""
"Chú giải công cụ phong phú hiển thị danh sách tất cả các chuỗi cho thời điểm"
" đó"

msgid ""
"The row limit set for the chart was reached. The chart may show partial "
"data."
msgstr ""
"Đã đạt đến giới hạn hàng được đặt cho biểu đồ. Biểu đồ có thể hiển thị một "
"phần dữ liệu."

#, python-format
msgid ""
"The schema \"%(schema)s\" does not exist. A valid schema must be used to run"
" this query."
msgstr ""
"Lược đồ \"%(schema)s\" không tồn tại. Phải sử dụng lược đồ hợp lệ để chạy "
"truy vấn này."

#, python-format
msgid ""
"The schema \"%(schema_name)s\" does not exist. A valid schema must be used "
"to run this query."
msgstr ""
"Lược đồ \"%(schema_name)s\" không tồn tại. Phải sử dụng lược đồ hợp lệ để "
"chạy truy vấn này."

msgid "The schema of the submitted payload is invalid."
msgstr "Lược đồ của tải trọng đã gửi không hợp lệ."

msgid "The schema was deleted or renamed in the database."
msgstr "Lược đồ đã bị xóa hoặc đổi tên trong cơ sở dữ liệu."

msgid "The screenshot could not be downloaded. Please, try again later."
msgstr "Không thể tải xuống ảnh chụp màn hình. Vui lòng thử lại sau."

msgid "The screenshot has been downloaded."
msgstr "Ảnh chụp màn hình đã được tải xuống."

msgid "The screenshot is being generated. Please, do not leave the page."
msgstr "Ảnh chụp màn hình đang được tạo. Làm ơn đừng rời khỏi trang."

msgid "The service url of the layer"
msgstr "Url dịch vụ của lớp"

msgid "The size of each cell in meters"
msgstr "Kích thước của mỗi ô tính bằng mét"

msgid "The size of the square cell, in pixels"
msgstr "Kích thước của ô vuông, tính bằng pixel"

msgid "The slope to compute all sizes from. \"LINEAR\" only"
msgstr "Độ dốc để tính toán tất cả các kích thước từ. chỉ \"TUYẾN TÍNH\""

msgid "The submitted payload failed validation."
msgstr "Tải trọng đã gửi không được xác thực."

msgid "The submitted payload has the incorrect format."
msgstr "Tải trọng đã gửi có định dạng không chính xác."

msgid "The submitted payload has the incorrect schema."
msgstr "Tải trọng đã gửi có lược đồ không chính xác."

#, python-format
msgid ""
"The table \"%(table)s\" does not exist. A valid table must be used to run "
"this query."
msgstr ""
"Bảng \"%(table)s\" không tồn tại. Một bảng hợp lệ phải được sử dụng để chạy "
"truy vấn này."

#, python-format
msgid ""
"The table \"%(table_name)s\" does not exist. A valid table must be used to "
"run this query."
msgstr ""
"Bảng \"%(table_name)s\" không tồn tại. Một bảng hợp lệ phải được sử dụng để "
"chạy truy vấn này."

msgid "The table was deleted or renamed in the database."
msgstr "Bảng đã bị xóa hoặc đổi tên trong cơ sở dữ liệu."

msgid ""
"The time column for the visualization. Note that you can define arbitrary "
"expression that return a DATETIME column in the table. Also note that the "
"filter below is applied against this column or expression"
msgstr ""
"Cột thời gian để hiển thị. Lưu ý rằng bạn có thể xác định biểu thức tùy ý "
"trả về cột DATETIME trong bảng. Cũng lưu ý rằng bộ lọc bên dưới được áp dụng"
" cho cột hoặc biểu thức này"

msgid ""
"The time granularity for the visualization. Note that you can type and use "
"simple natural language as in `10 seconds`, `1 day` or `56 weeks`"
msgstr ""
"Mức độ chi tiết về thời gian cho trực quan hóa. Lưu ý bạn có thể gõ và sử "
"dụng ngôn ngữ tự nhiên đơn giản như trong `10 giây`, `1 ngày` hoặc `56 tuần`"

msgid ""
"The time granularity for the visualization. Note that you can type and use "
"simple natural language as in `10 seconds`,`1 day` or `56 weeks`"
msgstr ""
"Mức độ chi tiết về thời gian cho trực quan hóa. Lưu ý rằng bạn có thể gõ và "
"sử dụng ngôn ngữ tự nhiên đơn giản như trong `10 giây`,`1 ngày` hoặc `56 "
"tuần`"

msgid ""
"The time granularity for the visualization. This applies a date "
"transformation to alter your time column and defines a new time granularity."
" The options here are defined on a per database engine basis in the Superset"
" source code."
msgstr ""
"Mức độ chi tiết về thời gian cho trực quan hóa. Điều này áp dụng chuyển đổi "
"ngày để thay đổi cột thời gian của bạn và xác định mức độ chi tiết của thời "
"gian mới. Các tùy chọn ở đây được xác định trên cơ sở từng công cụ cơ sở dữ "
"liệu trong mã nguồn Superset."

msgid ""
"The time range for the visualization. All relative times, e.g. \"Last "
"month\", \"Last 7 days\", \"now\", etc. are evaluated on the server using "
"the server's local time (sans timezone). All tooltips and placeholder times "
"are expressed in UTC (sans timezone). The timestamps are then evaluated by "
"the database using the engine's local timezone. Note one can explicitly set "
"the timezone per the ISO 8601 format if specifying either the start and/or "
"end time."
msgstr ""
"Phạm vi thời gian cho việc trực quan hóa. Tất cả thời gian tương đối, ví dụ:"
" \"Tháng trước\", \"7 ngày qua\", \"bây giờ\", v.v. được đánh giá trên máy "
"chủ bằng cách sử dụng giờ địa phương của máy chủ (không có múi giờ). Tất cả "
"chú giải công cụ và thời gian giữ chỗ được thể hiện bằng UTC (không có múi "
"giờ). Sau đó, dấu thời gian được cơ sở dữ liệu đánh giá bằng múi giờ cục bộ "
"của công cụ. Lưu ý người ta có thể đặt rõ ràng múi giờ theo định dạng ISO "
"8601 nếu chỉ định thời gian bắt đầu và/hoặc kết thúc."

msgid ""
"The time unit for each block. Should be a smaller unit than "
"domain_granularity. Should be larger or equal to Time Grain"
msgstr ""
"Đơn vị thời gian cho mỗi khối. Phải là đơn vị nhỏ hơn domain_grainarity. "
"Phải lớn hơn hoặc bằng Time Grain"

msgid "The time unit used for the grouping of blocks"
msgstr "Đơn vị thời gian được sử dụng để nhóm các khối"

msgid "The type of the layer"
msgstr "Loại của lớp"

msgid "The type of visualization to display"
msgstr "Loại trực quan hóa để hiển thị"

msgid "The unit of measure for the specified point radius"
msgstr "Đơn vị đo bán kính điểm được chỉ định"

msgid "The upper limit of the threshold range of the Isoband"
msgstr "Giới hạn trên của phạm vi ngưỡng của Isoband"

msgid "The user seems to have been deleted"
msgstr "Người dùng dường như đã bị xóa"

msgid ""
"The user/password combination is not valid (Incorrect password for user)."
msgstr ""
"Sự kết hợp người dùng/mật khẩu không hợp lệ (Mật khẩu không chính xác cho "
"người dùng)."

#, python-format
msgid "The username \"%(username)s\" does not exist."
msgstr "Tên người dùng \"%(username)s\" không tồn tại."

msgid "The username provided when connecting to a database is not valid."
msgstr ""
"Tên người dùng được cung cấp khi kết nối với cơ sở dữ liệu không hợp lệ."

msgid "The version of the service"
msgstr "Phiên bản của dịch vụ"

msgid "The visible title of the layer"
msgstr "Tiêu đề hiển thị của lớp"

msgid "The way the ticks are laid out on the X-axis"
msgstr "Cách các dấu tích được bố trí trên trục X"

msgid "The width of the Isoline in pixels"
msgstr "Chiều rộng của Isoline tính bằng pixel"

msgid "The width of the current zoom level to compute all widths from"
msgstr "Độ rộng của mức thu phóng hiện tại để tính toán tất cả các độ rộng từ"

msgid "The width of the elements border"
msgstr "Chiều rộng của đường viền phần tử"

msgid "The width of the lines"
msgstr "Chiều rộng của các dòng"

msgid "There are associated alerts or reports"
msgstr "Có cảnh báo hoặc báo cáo liên quan"

#, python-format
msgid "There are associated alerts or reports: %(report_names)s"
msgstr "Có các cảnh báo hoặc báo cáo liên quan: %(report_names)s"

msgid "There are no charts added to this dashboard"
msgstr "Không có biểu đồ nào được thêm vào bảng điều khiển này"

msgid "There are no components added to this tab"
msgstr "Không có thành phần nào được thêm vào tab này"

msgid "There are no filters in this dashboard."
msgstr "Không có bộ lọc nào trong bảng điều khiển này."

msgid "There are unsaved changes."
msgstr "Có những thay đổi chưa được lưu."

msgid ""
"There is a syntax error in the SQL query. Perhaps there was a misspelling or"
" a typo."
msgstr ""
"Có lỗi cú pháp trong truy vấn SQL. Có lẽ có lỗi chính tả hoặc lỗi đánh máy."

msgid "There is currently no information to display."
msgstr "Hiện tại không có thông tin để hiển thị."

msgid ""
"There is no chart definition associated with this component, could it have "
"been deleted?"
msgstr ""
"Không có định nghĩa biểu đồ nào liên quan đến thành phần này, nó có thể bị "
"xóa không?"

msgid ""
"There is not enough space for this component. Try decreasing its width, or "
"increasing the destination width."
msgstr ""
"Không có đủ không gian cho thành phần này. Hãy thử giảm chiều rộng của nó "
"hoặc tăng chiều rộng đích."

msgid "There was an error fetching dataset"
msgstr "Đã xảy ra lỗi khi tìm nạp tập dữ liệu"

msgid "There was an error fetching dataset's related objects"
msgstr "Đã xảy ra lỗi khi tìm nạp các đối tượng liên quan của tập dữ liệu"

